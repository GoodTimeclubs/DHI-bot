# ── Claude API ────────────────────────────────────────────────────────────────
# Ohne Key läuft der Bot im Mock-Modus (zeigt gefundene Quellen statt freier Antwort).
# Key erstellen: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=700
# Niedrig lassen: konsistente, regelkonforme Antworten (QS-getestet mit 0.3).
TEMPERATURE=0.3
# Reine Terminlistenfragen („Welche Übungstage gibt es in Stuttgart?") deterministisch
# aus termine.json beantworten statt per LLM-Auswahl — der früheste passende Termin
# kann so nie ausgelassen werden (QS-Befund 8). 0 = wieder alles per LLM.
DETERMINISTIC_TERMINE=1

# ── Crawler ──────────────────────────────────────────────────────────────────
# auto   = crawlen beim Start, falls noch kein Index existiert (Standard)
# always = bei jedem Start neu crawlen
# never  = nie automatisch crawlen (nur per POST /api/reindex)
CRAWL_ON_START=auto
# Stunde des täglichen Re-Crawls (0-23, Zeitzone unten)
CRAWL_HOUR=3
REQUEST_DELAY=0.5
# Erfasste Domains: Standard = Hauptdomain + alle 10 Subdomains (lars,
# nautilus-code, hypnospathie, hypnosepraxis-aschaffenburg/-berlin/-oberstaufen,
# praxen, hybrid, experte, legal — dort erscheinen später die neuen AGB).
# Nur setzen, wenn die Liste abweichen soll (kommagetrennt, ohne https://):
# CRAWL_DOMAINS=deutsches-hypnoseinstitut.de,hybrid.deutsches-hypnoseinstitut.de
# Obergrenze Seiten pro Crawl-Lauf (Schutz, falls eine Subdomain stark wächst;
# Stand 01.08.2026 hat der volle Crawl ~570 Seiten)
MAX_PAGES=600

# ── Reverse Proxy (Caddy) ────────────────────────────────────────────────────
# Leer = lokaler Betrieb unter http://localhost (ohne TLS).
# Produktiv: Domain eintragen, deren DNS auf diesen Server zeigt — Caddy holt
# und erneuert TLS-Zertifikate dann automatisch (Let's Encrypt), z. B.:
# DOMAIN=bot.deutsches-hypnoseinstitut.de
DOMAIN=

# ── Server & Absicherung ─────────────────────────────────────────────────────
# Für den lokalen Test reicht *; produktiv auf alle Domains einschränken, auf
# denen das Widget eingebunden wird (Hauptdomain + Subdomains), z.B.:
# ALLOWED_ORIGINS=https://deutsches-hypnoseinstitut.de,https://hybrid.deutsches-hypnoseinstitut.de,https://praxen.deutsches-hypnoseinstitut.de
ALLOWED_ORIGINS=*
# Token für den manuellen Re-Crawl-Endpunkt (POST /api/reindex, Header X-Admin-Token)
ADMIN_TOKEN=bitte-aendern
# Caddy läuft im Compose-Setup als Reverse Proxy mit → auf 1 lassen: echte
# Besucher-IP für das Rate-Limit aus X-Forwarded-For lesen.
# Nur leeren, wenn der Bot-Container OHNE Proxy direkt exponiert wird.
TRUST_PROXY=1
# Globale Kostenbremse: max. Chat-Nachrichten pro Tag über alle Besucher (0 = aus).
# Danach antwortet der Bot freundlich mit den direkten Kontaktwegen.
DAILY_MESSAGE_LIMIT=1000
TZ=Europe/Berlin
